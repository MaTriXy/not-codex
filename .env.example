# Optional: Not Codex Connect source builds
# Leave these unset to disable optional Not Codex Connect features in local source builds.
# Release builds inject their public values at build time. Do not add server-side
# secrets to this file.

# Get these from the Clerk Dashboard under API keys, JWT templates, and OAuth applications.
# NOT_CODEX_CLERK_PUBLISHABLE_KEY=pk_test_...
# NOT_CODEX_CLERK_JWT_TEMPLATE=notcodex-relay
# NOT_CODEX_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in NOT_CODEX_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# NOT_CODEX_APPLE_TEAM_ID=ABC1234567
# NOT_CODEX_MACOS_PROVISIONING_PROFILE=/absolute/path/to/notcodex.provisionprofile
# NOT_CODEX_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Get this from your relay deployment. `infra/relay` deploys update it automatically.
# NOT_CODEX_RELAY_URL=https://relay.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# NOT_CODEX_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# NOT_CODEX_MOBILE_OTLP_TRACES_DATASET=notcodex-mobile-traces-dev
# NOT_CODEX_MOBILE_OTLP_TRACES_TOKEN=xaat-...
