{
  "name": "notcodex",
  "version": "0.0.28",
  "description": "Local-first control plane for coding agents.",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agents",
    "developer-tools"
  ],
  "homepage": "https://notcodex.bpro.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaTriXy/not-codex",
    "directory": "apps/server"
  },
  "bin": {
    "notcodex": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "build:bundle": "vp pack && vp pack src/service-launcher.ts --out-dir dist --no-clean",
    "start": "node dist/bin.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.170",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@loopyc/core": "0.8.0",
    "@loopyc/infer": "0.8.0",
    "@loopyc/runtime": "0.8.0",
    "@loopyc/verify": "0.8.0",
    "@opencode-ai/sdk": "^1.3.15",
    "@pierre/diffs": "catalog:",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@notcodex/contracts": "workspace:*",
    "@notcodex/shared": "workspace:*",
    "@notcodex/tailscale": "workspace:*",
    "@notcodex/web": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "effect-pi-rpc": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
