---
import ProductFrame from "../components/ProductFrame.astro";
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

const proof = [
  ["5", "agent harnesses", "Codex, Claude Code, Cursor, OpenCode, and Grok"],
  ["1", "governed workspace", "Sessions, worktrees, approvals, and review"],
  ["3", "ways to run", "Interactive, scheduled, and bounded loops"],
  ["0", "hosted lock-in", "Local-first and MIT licensed"],
] as const;

const executionLayers = [
  {
    number: "01",
    title: "Ask in a real repository",
    body: "Start with the project, branch, and agent you want. Every task gets an explicit context instead of an anonymous terminal tab.",
  },
  {
    number: "02",
    title: "Run inside a governed lane",
    body: "Worktrees isolate concurrent changes while approvals, questions, tool calls, failures, and reconnects remain visible in one timeline.",
  },
  {
    number: "03",
    title: "Review before it lands",
    body: "Inspect checkpoints and diffs, prepare stacked work, and decide what becomes a commit or pull request. The agent never owns the last step.",
  },
] as const;

const automationFeatures = [
  ["Flexible schedules", "Run immediately, once, on an interval, or on a weekly schedule."],
  ["Bounded follow-through", "Continue until complete within explicit time and attempt limits."],
  ["Repository-aware", "Run project checks, isolate work in a worktree, and optionally prepare a branch or pull request."],
  ["Observable by default", "See history, next run, current state, notifications, and the resulting agent session."],
] as const;

const loopyFeatures = [
  ["Author with context", "Expose v0.5 context, recipes, and inference to supported coding agents."],
  ["Validate before execution", "Check specifications, effects, limits, and dry-run behavior before a run starts."],
  ["Bound the loop", "Set iteration and time limits instead of relying on an open-ended prompt."],
  ["Recover deliberately", "Persist receipts so runs can be inspected, cancelled, resumed, or retried after interruption."],
] as const;

const trustRows = [
  ["Credentials", "Use the provider CLIs and credentials already managed on your machine."],
  ["Execution", "Keep the server local and bind it to a trusted network only."],
  ["Changes", "Isolate concurrent work and retain human approval for destructive or consequential actions."],
  ["Recovery", "Persist session and integration state so restarts do not erase the audit trail."],
  ["Source", "Inspect the implementation and build it yourself under the MIT license."],
] as const;
---

<Layout
  title="Not Codex — The control plane for coding agents"
  description="Run Codex, Claude Code, Cursor, OpenCode, Grok, Automations, and bounded agent loops from one local-first workspace."
>
  <section class="hero">
    <div class="container hero__copy">
      <p class="eyebrow">Local-first agent control plane</p>
      <h1>Your agents can move fast.<br /><span>You can still see everything.</span></h1>
      <p class="hero__lede">
        Not Codex brings Codex, Claude Code, Cursor, OpenCode, and Grok into one governed workspace
        for interactive sessions, repository workflows, scheduled Automations, and bounded agent
        loops.
      </p>
      <div class="hero__actions">
        <a
          class="btn btn-primary"
          href={GITHUB_REPOSITORY_URL}
          target="_blank"
          rel="noopener noreferrer"
        >Explore the source <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#workflow">See how it works <span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero__availability">
        Public source today. Signed packages and a hosted app are not available yet.
      </p>
    </div>

    <div class="container hero__product">
      <ProductFrame
        src="/product/workspace.webp"
        label="Workspace / interactive session"
        alt="Not Codex desktop workspace showing an agent conversation, project sidebar, and execution controls."
        priority
      />
    </div>
  </section>

  <section class="proof" aria-label="Product facts">
    <div class="container">
      <dl class="proof__grid">
        {proof.map(([value, label, detail]) => (
          <div>
            <dt><span>{value}</span>{label}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="workflow" class="section workflow">
    <div class="container split split--copy-first">
      <div class="section-copy">
        <p class="eyebrow">Repository workflow</p>
        <h2>Work in parallel without making a mess.</h2>
        <p class="section-lede">
          Give each task an isolated lane. Keep branches, checkpoints, diffs, and stacked changes
          close to the conversation that produced them.
        </p>
        <dl class="compact-features">
          <div>
            <dt>Separate worktrees</dt>
            <dd>Concurrent agents do not silently overwrite each other.</dd>
          </div>
          <div>
            <dt>Reviewable checkpoints</dt>
            <dd>Inspect what changed before you commit, push, or open a pull request.</dd>
          </div>
          <div>
            <dt>Stack-aware handoff</dt>
            <dd>Keep dependent branches legible while work moves toward main.</dd>
          </div>
        </dl>
      </div>
      <ProductFrame
        src="/product/repository-workflow.webp"
        label="Repository / isolated work"
        alt="Not Codex repository view showing worktree status, changed files, and branch actions."
      />
    </div>
  </section>

  <section class="execution section">
    <div class="container">
      <header class="section-heading">
        <p class="eyebrow">One execution model</p>
        <h2>Different agents. The same clear path to review.</h2>
        <p>
          Interactive sessions, Automations, Loopy specifications, and accepted LoopAny deliveries
          all enter the ordinary Not Codex harness. That keeps approvals and repository safeguards in
          the path regardless of how work begins.
        </p>
      </header>

      <dl class="execution__steps">
        {executionLayers.map((step) => (
          <div>
            <dt><span>{step.number}</span>{step.title}</dt>
            <dd>{step.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="automations" class="section automations">
    <div class="container split split--media-first">
      <ProductFrame
        src="/product/automations.webp"
        label="Automations / schedule and history"
        alt="Not Codex Automations screen showing a scheduled repository task, execution settings, and run history."
      />
      <div class="section-copy">
        <p class="eyebrow">Automations</p>
        <h2>Schedule outcomes, not blind scripts.</h2>
        <p class="section-lede">
          Turn a well-scoped task into a recurring agent workflow while retaining the same project
          checks, isolation, notifications, and review surface as an interactive session.
        </p>
        <dl class="lined-features">
          {automationFeatures.map(([title, body], index) => (
            <div>
              <dt><span>{String(index + 1).padStart(2, "0")}</span>{title}</dt>
              <dd>{body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section id="loopy" class="section loopy">
    <div class="container">
      <header class="section-heading section-heading--wide">
        <p class="eyebrow">Monkey D. Loopy v0.5</p>
        <h2>When a prompt needs a bounded, verifiable loop.</h2>
        <p>
          Author and inspect a structured loop, validate its control flow, then execute every agent
          step through a normal Not Codex thread. Verification checks the specification and mocked
          effects; it does not certify model quality.
        </p>
      </header>

      <div class="loopy__authoring">
        <ProductFrame
          src="/product/loopy-authoring.webp"
          label="Loopy / author and validate"
          alt="Not Codex Loopy authoring screen showing a bounded YAML specification and validation controls."
        />
        <dl class="lined-features lined-features--light">
          {loopyFeatures.map(([title, body], index) => (
            <div>
              <dt><span>{String(index + 1).padStart(2, "0")}</span>{title}</dt>
              <dd>{body}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="loopy__receipt">
        <div class="section-copy">
          <p class="eyebrow">Durable run receipt</p>
          <h3>Follow the loop without losing the thread.</h3>
          <p class="section-lede">
            Each run has an environment-scoped receipt with status, bounded progress, timestamps,
            the underlying session, and explicit cancel, resume, or retry controls.
          </p>
          <aside class="honesty-note" role="note">
            This synthetic capture shows an active bounded run. It is product evidence, not a claim
            that every model response or external service will succeed.
          </aside>
        </div>
        <ProductFrame
          src="/product/loopy-run.webp"
          label="Loopy / active run receipt"
          alt="Not Codex Loopy run screen showing an active durable receipt and the agent session created for the run."
        />
      </div>
    </div>
  </section>

  <section class="section loopany">
    <div class="container split split--copy-first">
      <div class="section-copy">
        <p class="eyebrow">Optional LoopAny connector</p>
        <h2>Accept scheduled work without moving execution to the cloud.</h2>
        <p class="section-lede">
          A compatible LoopAny server can schedule and deliver work. Not Codex root-jails accepted
          paths and routes the work through its local harness instead of evaluating remote workflow
          source on your machine.
        </p>
        <aside class="honesty-note honesty-note--warning" role="note">
          LoopAny is disabled by default and requires your own compatible server and token. The
          project has not claimed a live production round trip; this capture intentionally shows the
          real unconfigured diagnostics state.
        </aside>
      </div>
      <ProductFrame
        src="/product/loopany.webp"
        label="LoopAny / disabled by default"
        alt="Not Codex LoopAny settings showing the optional connector disabled and its diagnostic fields."
      />
    </div>
  </section>

  <section class="section mobile">
    <div class="container mobile__grid">
      <div class="mobile__visual">
        <ProductFrame
          src="/product/mobile-run.webp"
          label="Paired mobile client"
          alt="Not Codex mobile client showing a completed synthetic Loopy run and its changed files."
          phone
        />
      </div>
      <div class="section-copy">
        <p class="eyebrow">Cross-device control</p>
        <h2>Keep an eye on the work when you leave the desk.</h2>
        <p class="section-lede">
          The mobile app controls a paired Not Codex environment. Review sessions, answer questions,
          inspect durable integration runs, and manage safe connector settings from the same model.
        </p>
        <dl class="compact-features">
          <div>
            <dt>Paired, not duplicated</dt>
            <dd>The phone is a client. Agents, Loopy, and LoopAny do not execute on the device.</dd>
          </div>
          <div>
            <dt>One recovery story</dt>
            <dd>Web and mobile read the server-authoritative state after reconnects or restarts.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="trust" class="section trust">
    <div class="container trust__grid">
      <header class="section-heading section-heading--stacked">
        <p class="eyebrow">Trust boundary</p>
        <h2>Fast agents still need visible limits.</h2>
        <p>
          Not Codex is designed around ownership and recovery rather than invisible autonomy. It is
          early software, so you should still use recoverable repositories and inspect agent actions.
        </p>
      </header>

      <dl class="trust__ledger">
        {trustRows.map(([title, body], index) => (
          <div>
            <dt><span>{String(index + 1).padStart(2, "0")}</span>{title}</dt>
            <dd>{body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="available" class="section availability">
    <div class="container availability__grid">
      <div>
        <p class="eyebrow">Available now</p>
        <h2>Open source and ready to inspect.</h2>
        <p>
          The repository, architecture, security guidance, integration docs, and this public site are
          available today. Build locally if you want to explore the work in progress.
        </p>
        <a class="text-link" href="/download">Read the build guide <span aria-hidden="true">↗</span></a>
      </div>
      <div>
        <p class="eyebrow">What comes next</p>
        <h2>Packaging, hardening, and proof.</h2>
        <p>
          Signed desktop packages, broader installation paths, continued security review, and more
          production evidence are the next milestones. They are planned, not promised.
        </p>
        <a
          class="text-link"
          href={`${GITHUB_REPOSITORY_URL}/issues`}
          target="_blank"
          rel="noopener noreferrer"
        >Follow the roadmap <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-cta__inner">
      <div>
        <p class="eyebrow">Not another agent</p>
        <h2>A place to run the agents you already trust.</h2>
      </div>
      <div class="final-cta__actions">
        <a
          class="text-link"
          href={GITHUB_REPOSITORY_URL}
          target="_blank"
          rel="noopener noreferrer"
        >Explore the source <span aria-hidden="true">↗</span></a>
        <a class="btn btn-ghost" href="/download">Build it locally</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section {
    border-top: 1px solid var(--line-strong);
    padding-block: var(--section-space);
  }

  .hero {
    padding-block: clamp(76px, 9vw, 126px) clamp(72px, 9vw, 118px);
  }

  .hero__copy {
    display: grid;
    justify-items: start;
  }

  .hero h1 {
    max-width: 18ch;
    margin-top: 22px;
    font-size: clamp(3.35rem, 7.7vw, 7.45rem);
    letter-spacing: -0.066em;
  }

  .hero h1 span {
    color: var(--ink-muted);
  }

  .hero__lede {
    max-width: 65ch;
    margin-top: 30px;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 2vw, 1.32rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 34px;
  }

  .hero__availability {
    max-width: 64ch;
    margin-top: 22px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .hero__product {
    margin-top: clamp(58px, 8vw, 102px);
  }

  .proof {
    border-top: 1px solid var(--line-strong);
    padding-block: 30px;
    background: var(--paper-soft);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .proof__grid > div {
    min-width: 0;
    padding-inline: 24px;
    border-left: 1px solid var(--line);
  }

  .proof__grid > div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .proof__grid > div:last-child {
    padding-right: 0;
  }

  .proof dt {
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 650;
  }

  .proof dt span {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.55rem;
    font-variant-numeric: tabular-nums;
  }

  .proof dd {
    margin-top: 6px;
    color: var(--ink-muted);
    font-size: 0.8rem;
  }

  .split {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(340px, 5fr) minmax(0, 7fr);
    gap: clamp(54px, 7vw, 92px);
  }

  .split--media-first {
    grid-template-columns: minmax(0, 7fr) minmax(340px, 5fr);
  }

  .section-copy {
    min-width: 0;
  }

  .section-copy h2,
  .section-copy h3,
  .section-heading h2,
  .availability h2,
  .final-cta h2 {
    max-width: 15ch;
    margin-top: 18px;
    font-size: clamp(2.75rem, 5vw, 5.1rem);
    letter-spacing: -0.055em;
  }

  .section-copy h3 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 4vw, 4rem);
  }

  .section-lede,
  .section-heading > p:last-child,
  .availability p {
    max-width: 59ch;
    margin-top: 25px;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }

  .compact-features {
    margin-top: 40px;
    border-top: 1px solid var(--line-strong);
  }

  .compact-features > div {
    padding-block: 18px 20px;
    border-bottom: 1px solid var(--line);
  }

  .compact-features dt {
    color: var(--ink);
    font-size: 0.94rem;
    font-weight: 650;
  }

  .compact-features dd {
    margin-top: 5px;
    color: var(--ink-muted);
    font-size: 0.86rem;
  }

  .execution {
    background: var(--ink);
    color: var(--paper-soft);
  }

  .execution .eyebrow,
  .loopy .eyebrow {
    color: #ff8c68;
  }

  .section-heading {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 7fr) minmax(320px, 5fr);
    gap: 28px clamp(56px, 9vw, 130px);
  }

  .section-heading .eyebrow {
    grid-column: 1 / -1;
  }

  .section-heading h2 {
    max-width: 16ch;
    margin-top: 0;
  }

  .execution .section-heading > p:last-child {
    color: #b7b4aa;
  }

  .execution__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(64px, 9vw, 112px);
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }

  .execution__steps > div {
    padding: 28px 34px 12px;
    border-left: 1px solid rgba(255, 255, 255, 0.18);
  }

  .execution__steps > div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .execution__steps > div:last-child {
    padding-right: 0;
  }

  .execution__steps dt {
    max-width: 19ch;
    color: var(--paper-soft);
    font-size: 1.16rem;
    font-weight: 650;
  }

  .execution__steps dt span {
    display: block;
    margin-bottom: 54px;
    color: #ff8c68;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .execution__steps dd {
    max-width: 36ch;
    margin-top: 17px;
    color: #aaa89f;
    font-size: 0.88rem;
  }

  .automations {
    background: var(--paper-soft);
  }

  .lined-features {
    margin-top: 42px;
    border-top: 1px solid var(--line-strong);
  }

  .lined-features > div {
    padding-block: 19px 22px;
    border-bottom: 1px solid var(--line);
  }

  .lined-features dt {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 650;
  }

  .lined-features dt span {
    color: var(--accent-dark);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .lined-features dd {
    margin: 7px 0 0 36px;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }

  .loopy {
    background: var(--ink);
    color: var(--paper-soft);
  }

  .section-heading--wide h2 {
    max-width: 15ch;
  }

  .loopy .section-heading > p:last-child,
  .loopy .section-lede {
    color: #b7b4aa;
  }

  .loopy__authoring {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(0, 8fr) minmax(310px, 4fr);
    gap: clamp(48px, 7vw, 88px);
    margin-top: clamp(64px, 9vw, 112px);
  }

  .lined-features--light {
    margin-top: 0;
    border-top-color: rgba(255, 255, 255, 0.28);
  }

  .lined-features--light > div {
    border-bottom-color: rgba(255, 255, 255, 0.17);
  }

  .lined-features--light dt {
    color: var(--paper-soft);
  }

  .lined-features--light dt span {
    color: #ff8c68;
  }

  .lined-features--light dd {
    color: #aaa89f;
  }

  .loopy__receipt {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(320px, 4fr) minmax(0, 8fr);
    gap: clamp(48px, 7vw, 88px);
    margin-top: clamp(96px, 12vw, 160px);
  }

  .honesty-note {
    max-width: 62ch;
    margin-top: 30px;
    padding: 16px 18px;
    border-left: 3px solid var(--accent);
    background: rgba(239, 90, 54, 0.08);
    color: #b7b4aa;
    font-size: 0.84rem;
  }

  .honesty-note--warning {
    background: var(--paper-warm);
    color: var(--ink-soft);
  }

  .loopany {
    background: var(--paper-warm);
  }

  .mobile__grid {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(300px, 5fr) minmax(0, 7fr);
    gap: clamp(56px, 10vw, 140px);
  }

  .mobile__visual {
    display: flex;
    justify-content: center;
  }

  .trust {
    background: var(--paper-soft);
  }

  .trust__grid {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(320px, 5fr) minmax(0, 7fr);
    gap: clamp(56px, 10vw, 140px);
  }

  .section-heading--stacked {
    display: block;
  }

  .section-heading--stacked h2 {
    margin-top: 18px;
  }

  .trust__ledger {
    border-top: 1px solid var(--line-strong);
  }

  .trust__ledger > div {
    display: grid;
    grid-template-columns: minmax(150px, 3fr) minmax(0, 7fr);
    gap: 24px;
    padding-block: 22px 24px;
    border-bottom: 1px solid var(--line);
  }

  .trust__ledger dt {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 650;
  }

  .trust__ledger dt span {
    color: var(--accent-dark);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-variant-numeric: tabular-nums;
  }

  .trust__ledger dd {
    color: var(--ink-muted);
    font-size: 0.88rem;
  }

  .availability {
    background: var(--accent-soft);
  }

  .availability__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(56px, 10vw, 140px);
  }

  .availability__grid > div + div {
    border-left: 1px solid rgba(24, 23, 19, 0.2);
    padding-left: clamp(56px, 10vw, 140px);
  }

  .availability h2 {
    max-width: 14ch;
    font-size: clamp(2.45rem, 4vw, 4rem);
  }

  .availability p {
    color: #5d3b31;
  }

  .availability .text-link {
    margin-top: 28px;
  }

  .final-cta {
    padding-block: clamp(80px, 11vw, 142px);
  }

  .final-cta__inner {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 8fr) minmax(260px, 4fr);
    gap: 48px;
  }

  .final-cta h2 {
    max-width: 16ch;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 14px 22px;
  }

  @media (max-width: 980px) {
    .split,
    .split--media-first,
    .section-heading,
    .loopy__authoring,
    .loopy__receipt,
    .mobile__grid,
    .trust__grid,
    .final-cta__inner {
      grid-template-columns: 1fr;
    }

    .split--media-first > .section-copy {
      grid-row: 1;
    }

    .section-heading .eyebrow {
      grid-column: auto;
    }

    .loopy__authoring,
    .loopy__receipt {
      gap: 54px;
    }

