---
import {
  CONTACT_EMAILS,
  GITHUB_REPOSITORY_URL,
  MARKETING_SITE_URL,
} from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Not Codex — The control plane for coding agents",
  description =
    "A local-first, open-source control plane for Codex, Claude Code, Cursor, Grok Build, OpenCode, and Pi.",
  pageClass,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, MARKETING_SITE_URL);
---

<html lang="en" class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${MARKETING_SITE_URL}/icon.webp`} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class:list={["page", pageClass]}>
      <header class="site-header">
        <div class="site-header__inner">
          <a href="/" class="brand" aria-label="Homepage">
            <img src="/icon.webp" width="512" height="512" alt="" />
            <span>Not Codex</span>
          </a>

          <nav class="site-nav" aria-label="Main navigation">
            <a href="/#providers">Providers</a>
            <a href="/#workflow">Workflow</a>
            <a href="/#automations">Automations</a>
            <a href="/#trust">Trust</a>
          </nav>

          <a
            class="header-action"
            href={GITHUB_REPOSITORY_URL}
            target="_blank"
            rel="noopener noreferrer"
          >Source <span aria-hidden="true">↗</span></a>

          <details class="mobile-nav">
            <summary>Menu</summary>
            <nav aria-label="Mobile navigation">
              <a href="/#providers">Providers</a>
              <a href="/#workflow">Workflow</a>
              <a href="/#automations">Automations</a>
              <a href="/#workspace">Workspace</a>
              <a href="/#trust">Trust</a>
              <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Source</a>
            </nav>
          </details>
        </div>
      </header>

      <main id="main-content" class="main isolate">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer__inner">
          <div class="footer__intro">
            <a href="/" class="brand brand--footer" aria-label="Homepage">
              <img src="/icon.webp" width="512" height="512" alt="" />
              <span>Not Codex</span>
            </a>
            <p>A local-first control plane for coding agents.</p>
          </div>

          <nav class="footer__links" aria-label="Footer navigation">
            <div>
              <strong>Project</strong>
              <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
              <a href="/download">Build from source</a>
              <a href="/#available">Availability</a>
            </div>
            <div>
              <strong>Legal</strong>
              <a href="/legal">Legal center</a>
              <a href="/terms-of-service">Terms</a>
              <a href="/privacy-policy">Privacy</a>
              <a href="/security-policy">Security</a>
            </div>
            <div>
              <strong>Contact</strong>
              <a href={`mailto:${CONTACT_EMAILS.support}`}>Support</a>
              <a href={`mailto:${CONTACT_EMAILS.privacy}`}>Privacy</a>
              <a href={`mailto:${CONTACT_EMAILS.security}`}>Security</a>
            </div>
          </nav>
        </div>

        <div class="footer__disclosure" role="note">
          <p>
            Not Codex is independent and is not affiliated with, sponsored by, or endorsed by
            OpenAI, Anthropic, Cursor, OpenCode, xAI, T3 Tools, or T3 Code. Codex and OpenAI are
            OpenAI marks; Claude and Claude Code are Anthropic marks; Grok is an xAI mark; Cursor,
            OpenCode, T3 Tools, and T3 Code are marks of their respective owners.
          </p>
        </div>

        <div class="footer__meta">
          <span>&copy; {new Date().getFullYear()} MaTrixy</span>
          <span>MIT licensed</span>
        </div>
      </footer>
    </div>

    <script is:inline src="/site.js"></script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #f4f0e7;
    --paper-soft: #faf7f0;
    --paper-warm: #ebe4d7;
    --ink: #181713;
    --ink-soft: #4f4c44;
    --ink-muted: #716c61;
    --ink-faint: #918a7d;
    --ink-on-dark: #f5f2ea;
    --line: rgba(24, 23, 19, 0.13);
    --line-strong: rgba(24, 23, 19, 0.28);
    --accent: #ef5a36;
    --accent-dark: #a62f17;
    --accent-soft: #f6c5b5;
    --success: #2d7146;
    --warning: #9b581d;
    --bg: var(--paper);
    --bg-elev: var(--paper-soft);
    --bg-card: var(--paper-soft);
    --fg: var(--ink);
    --fg-muted: var(--ink-soft);
    --fg-dim: var(--ink-muted);
    --fg-faint: var(--ink-faint);
    --border: var(--line);
    --border-strong: var(--line-strong);
    --accent-strong: var(--accent-dark);
    --ok: var(--success);
    --warn: var(--warning);
    --font-sans: InterVariable, Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --radius-sm: 8px;
    --radius: 14px;
    --radius-lg: 22px;
    --page-width: 1240px;
    --page-gutter: clamp(20px, 4vw, 56px);
    --section-space: clamp(88px, 11vw, 152px);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--paper);
    scroll-behavior: smooth;
    scroll-padding-top: 92px;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 16px;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11", "ss01";
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  ::selection {
    background: var(--accent-soft);
    color: var(--ink);
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .container {
    width: min(100%, var(--page-width));
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .eyebrow {
    color: var(--accent-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .btn {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    font-size: 0.94rem;
    font-weight: 650;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper-soft);
    box-shadow: 0 0 0 1px var(--ink);
  }

  .btn-primary:hover {
    background: #302e28;
  }

  .btn-ghost {
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .btn-ghost:hover {
    border-color: var(--ink);
    background: rgba(24, 23, 19, 0.04);
  }

  .text-link {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid var(--ink);
    font-size: 0.94rem;
    font-weight: 650;
  }

  .skip-link {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 100;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--paper-soft);
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<style>
  .page {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    overflow-x: clip;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }

  .site-header__inner {
    display: grid;
    width: min(100%, var(--page-width));
    min-height: 72px;
    align-items: center;
    grid-template-columns: 1fr auto 1fr;
    gap: 28px;
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    min-height: 48px;
    min-width: 0;
    align-items: center;
    gap: 10px;
    font-size: 0.93rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand img {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 7px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 38px);
  }

  .site-nav a,
  .header-action {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .site-nav a {
    color: var(--ink-muted);
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .header-action {
    justify-self: end;
    border-bottom: 1px solid var(--ink);
    padding-block: 7px 5px;
  }

  .mobile-nav {
    display: none;
    position: relative;
    justify-self: end;
  }

  .mobile-nav summary {
    display: flex;
    min-width: 48px;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 650;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav nav {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    width: min(260px, calc(100vw - 40px));
    padding: 8px;
    border-radius: var(--radius);
    background: var(--paper-soft);
    box-shadow: 0 18px 52px rgba(24, 23, 19, 0.14), 0 0 0 1px var(--line);
  }

  .mobile-nav nav a {
    min-height: 48px;
    padding: 13px 12px;
    border-radius: 7px;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .mobile-nav nav a:hover {
    background: var(--paper-warm);
    color: var(--ink);
  }

  .main {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .footer {
    margin-top: auto;
    border-top: 1px solid var(--line-strong);
    padding: 72px var(--page-gutter) 28px;
  }

  .footer__inner,
  .footer__disclosure,
  .footer__meta {
    width: min(100%, calc(var(--page-width) - (2 * var(--page-gutter))));
    margin-inline: auto;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) auto;
    gap: 56px;
  }

  .brand--footer img {
    width: 24px;
    height: 24px;
    border-radius: 6px;
  }

  .footer__intro p {
    max-width: 32ch;
    margin-top: 16px;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  .footer__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(108px, 1fr));
    gap: 46px;
  }

  .footer__links div {
    display: grid;
    align-content: start;
    gap: 9px;
  }

  .footer__links strong {
    padding-bottom: 4px;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer__links a {
    display: flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink-muted);
    font-size: 0.86rem;
    font-weight: 400;
  }

  .footer__links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__disclosure {
    margin-top: 64px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .footer__disclosure p {
    max-width: 108ch;
    color: var(--ink-muted);
    font-size: 0.8rem;
  }

  .footer__meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 24px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .site-header__inner {
      min-height: 64px;
      grid-template-columns: 1fr auto;
    }

    .site-nav,
    .header-action {
      display: none;
    }

    .mobile-nav {
      display: block;
    }

    .legal-document-page .site-header {
      display: none;
    }

    .footer__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .footer {
      padding-top: 56px;
      padding-bottom: max(28px, env(safe-area-inset-bottom));
    }

    .footer__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 24px;
    }

    .footer__disclosure {
      margin-top: 48px;
    }

    .footer__disclosure p {
      font-size: 0.88rem;
    }

    .footer__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 7px;
    }
  }
</style>
